{
  "headers": [
    {
      "source": "/(admin|admin/.*|agendamento/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|llms\\.txt|llms-full\\.txt|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
