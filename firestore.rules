rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated and registered in the 'admins' collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins Collection:
    // Read: authenticated user can read their own admin document
    // Write: FORBIDDEN client-side. First admin and new admins MUST be provisioned via Firebase Console / Admin SDK.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Services Catalog: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Settings: Public read, Admin write
    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blocked Periods: Public read to calculate schedule availability, Admin write
    match /blockedPeriods/{periodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking Slots (Deterministic locks for double-booking prevention - NO PII stored inside)
    // Public read for real-time slot checking
    // Atomic create/delete during booking transactions
    match /bookingSlots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.date is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (resource.data.date is string);
    }

    // Official Bookings Document (Contains full customer PII)
    // Strictly protected: Get, List, Update, Delete ONLY permitted for authenticated admins!
    // Public create allowed during atomic booking transaction
    match /bookings/{bookingId} {
      allow list, delete: if isAdmin();
      allow get, update: if isAdmin() || (resource.data.status == "confirmed" && request.resource.data.status == "cancelled");
      allow create: if request.resource.data.status == "confirmed"
                    && request.resource.data.customerName is string
                    && request.resource.data.customerPhone is string;
    }

    // Public Customer Booking Tokens (Self-service via 48-char cryptographically strong token document ID)
    // Get: Allowed by exact document ID (token has $10^57$ entropy, impossible to enumerate or guess)
    // List: Forbidden to public (Admin only)
    // Update: Allowed for customer cancellation or by Admin
    match /bookingTokens/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.bookingId is string;
      allow update: if (resource.data.status == "confirmed" && request.resource.data.status == "cancelled") || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
