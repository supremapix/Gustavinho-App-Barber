rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated and registered in the 'admins' collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins Collection:
    // Read: authenticated user can read their own admin document
    // Write: FORBIDDEN client-side.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Services Catalog: Public read, Admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Settings: Public read, Admin write
    match /businessSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blocked Periods: Public read to calculate schedule availability, Admin write
    match /blockedPeriods/{periodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booking Slots (Deterministic locks for double-booking prevention)
    // Public read for real-time slot checking
    // Atomic create allowed during new booking creation
    // Update and Delete strictly restricted to authenticated Admin
    match /bookingSlots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.date is string || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Official Bookings Document (Contains full customer PII)
    // Strictly protected: Get, List, Update, Delete ONLY permitted for authenticated admins!
    // Public create allowed during customer booking creation with valid data
    match /bookings/{bookingId} {
      allow get, list, update, delete: if isAdmin();
      allow create: if request.resource.data.status == "confirmed"
                    && request.resource.data.customerName is string
                    && request.resource.data.customerPhone is string;
    }

    // Public Customer Booking Tokens (Self-service lookup)
    // Get: Allowed by exact document ID (individual lookup)
    // List: Forbidden to public (Admin only)
    // Create: Allowed during customer booking creation
    // Update, Delete: Admin ONLY
    match /bookingTokens/{token} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.bookingId is string || isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}

